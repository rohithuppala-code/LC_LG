# LLM Provider Selection: "openai" | "google" | "groq"
DEFAULT_LLM_PROVIDER=google

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Fast & Free tier available at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Tracing (Optional, for observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=cogniflow-dev
